# soulmount — environment configuration
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# Secrets never appear in logs, commits, FACTS.md, or chat output (guardrail 5).
# Every variable below is documented; defaults shown are the project defaults.
#
# NOTE: the Makefile `include`s this file, so keep secret VALUES free of unescaped
# '#', '$', and backslashes (a raw '#' truncates the value as a make comment). The
# recommended generators below all produce safe values.

# ─────────────────────────────────────────────────────────────────────────────
# Paths & hosts
# ─────────────────────────────────────────────────────────────────────────────

# Where ALL personal content lives. Never inside the repo, never under /mnt/c.
# Dev (laptop): e.g. /home/you/soulmount-data
# Prod (attic WSL2): ~/soulmount-data  (WSL ext4)
SOULMOUNT_DATA_DIR=

# Robot host. mDNS name first; scripts fall back to REACHY_IP if it won't resolve
# (mDNS is unreliable from inside WSL2 — production uses the reserved IP).
REACHY_HOST=reachy-mini.local
REACHY_IP=

# Robot SSH (Phase 0 installs keys and rotates the factory password).
REACHY_SSH_USER=pollen

# Brain service location.
# Dev: localhost. Prod: the attic PC's reserved LAN IP (mirrored WSL networking).
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8100
# WSL sshd port — 2222 avoids a mirrored-mode collision with a Windows sshd on 22.
BRAIN_SSH_PORT=2222
# Attic WSL ssh account (the Windows-linked WSL user — usually NOT the robot's
# 'pollen'). Used by verify-boot / migrate-data / attic-inventory. Empty = laptop $USER.
BRAIN_SSH_USER=

# Bearer token the body app / channels / callers present to the brain API.
# Generate a strong random value: `openssl rand -hex 32`
BRAIN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Upstream model provider (§7.1 adapter — model-agnostic behind one var)
# ─────────────────────────────────────────────────────────────────────────────

# openrouter (default) | anthropic | openai-compatible
BRAIN_PROVIDER=openrouter

# --- openrouter ---
OPENROUTER_API_KEY=
# Verified present on OpenRouter 2026-07-22: x-ai/grok-4.5 ($2/$6 per Mtok),
# x-ai/grok-4.20 ($1.25/$2.50 — the cheaper bake-off sibling).
BRAIN_MODEL=x-ai/grok-4.5

# Optional per-runner overrides; default to BRAIN_MODEL.
METIME_MODEL=
STUDIO_MODEL=

# --- anthropic (alternate) ---
ANTHROPIC_API_KEY=

# --- generic openai-compatible (alternate: direct provider or future local box) ---
BRAIN_UPSTREAM_BASE_URL=
BRAIN_UPSTREAM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Budget guard & sleep state (§7.7 — hard caps, no runtime override)
# ─────────────────────────────────────────────────────────────────────────────
BUDGET_DAILY_USD=5
BUDGET_MONTHLY_USD=30
# Day/month boundaries evaluated in this tz. Empty = system timezone.
BUDGET_TZ=
# When today's remaining budget falls below this, allow one final short turn
# so a conversation in flight ends gracefully, then sleep.
BUDGET_GOODNIGHT_RESERVE_USD=0.05

# Identity blob size budget (tokens).
IDENTITY_MAX_TOKENS=6000
# How many recent daily files feed the identity compile.
MEMORY_DAILY_DAYS=3

# ─────────────────────────────────────────────────────────────────────────────
# Voice (decided by the Phase 2 bake-off; body app works under both)
# ─────────────────────────────────────────────────────────────────────────────
# local | realtime
VOICE_BACKEND=local
# If realtime wins: a slim, byte-stable identity compiled once per session.
REALTIME_IDENTITY_MAX_TOKENS=1500

# ─────────────────────────────────────────────────────────────────────────────
# Channels — Telegram (Phase 5). Owner fills all of these.
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs — the exact household allowlist.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_FAMILY_CHAT_ID=
# Hard cap on proactive (robot-initiated) messages per person per week.
PROACTIVE_WEEKLY_CAP_PER_PERSON=5
# The Sunday doodle share is the robot's own weekly choice.
SUNDAY_DOODLE=true

# ─────────────────────────────────────────────────────────────────────────────
# Inner life — me time (Phase 6)
# ─────────────────────────────────────────────────────────────────────────────
METIME_HOUR=23
# Euro cap on a night's me-time MODEL spend (inside the §7.7 leftover allowance).
METIME_EUR_CAP=0.50
# Tool-call ceiling per me-time session.
METIME_MAX_TOOL_CALLS=25
# Fallback €/token table for NON-OpenRouter providers only (OpenRouter reports
# exact per-generation cost). Path to a JSON file, optional.
METIME_PRICE_TABLE=

# Search provider for me time. brave (free tier) default; searxng self-hosted
# is the zero-cost alternative (needs its own egress allowlist entry).
SEARCH_API_PROVIDER=brave
SEARCH_API_KEY=
# For searxng: the base URL of your instance.
SEARXNG_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Studio — the vlog (Phase 8, gated). Off by default.
# ─────────────────────────────────────────────────────────────────────────────
STUDIO_ENABLED=false
# Euro cap on MODEL tokens per video (TTS + rendering are local and free).
STUDIO_PER_VIDEO_EUR_CAP=0.75
YOUTUBE_CLIENT_SECRETS_PATH=
YOUTUBE_CHANNEL_ID=
YOUTUBE_DEFAULT_VISIBILITY=unlisted
